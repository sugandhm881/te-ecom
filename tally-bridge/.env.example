# ─── Tally Bridge Agent ───────────────────────────────────────────────────────
# Copy to `.env` (same folder) and fill in. Run on the PC where TALLY is running.

# Where Ecom Central is reachable FROM this PC.
#   live  : https://dashboard.theelement.skin
#   local : http://localhost:5002
DASHBOARD_URL=https://dashboard.theelement.skin

# Must be byte-identical to TALLY_BRIDGE_KEY in the server's .env.
# Without it every /api/tally/bridge/* call is refused (503) — it never falls open.
BRIDGE_KEY=

# Tally's XML gateway on THIS machine.
# Enable it in Tally: F1 (Help) → Settings → Connectivity → Client/Server configuration
#   → "Tally acts as: Both", Port: 9000
TALLY_URL=http://localhost:9000

# Leave blank to use whichever company Tally currently has open.
TALLY_COMPANY=

POLL_MS=5000          # queue + heartbeat interval
SYNC_MINUTES=15       # how often masters + books are uploaded
PULL_LIMIT=5          # max vouchers claimed per poll
VERBOSE=false
