# ─── Pravidhi — environment template ─────────────────────────────────────
# Copy to `.env`, fill in real values, then SEAL it:  node tools/secrets.js init && npm run secrets:encrypt
# That writes `.env.vault` (AES-256-GCM, key in ~/.pravidhi/master.key). Locally this `.env` stays and is
# the file you edit — the vault is re-sealed from it at every boot. On a SERVER run `encrypt --delete`
# so only the encrypted copy remains, and edit there with `npm run secrets -- set KEY VALUE`.
# NEVER commit `.env` or `.env.vault` (both git-ignored). Every variable is read through config.js —
# see PROJECT_DOCUMENTATION.md §12 and §17.

# ── Server ──
PORT=5002
JWT_SECRET=                       # REQUIRED — random string, ≥32 chars (app refuses weak secrets)
DASHBOARD_URL=http://localhost:5002

# ── Bootstrap admin (always able to log in) ──
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=
APP_USER_NAME=            # optional — display name shown on the welcome splash for the bootstrap admin

# ── Supabase (service role — server-side only) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# ── Tally Prime (Finance → Data Entry) ──
# Tally's XML gateway (Gateway of Tally → F1 → Advanced Config → set "Tally acts as: Both", port 9000)
# only listens on localhost of the finance PC.
#   bridge → LIVE/VPS. Vouchers queue in tally_vouchers_ecom; the agent in tally-bridge/ (run on the
#            Tally PC) pulls and posts them. Requires TALLY_BRIDGE_KEY on both sides.
#   direct → the app is running ON the Tally machine; posting is synchronous.
TALLY_MODE=bridge
TALLY_URL=http://localhost:9000
TALLY_COMPANY=              # optional — blank means "whichever company Tally has open"
TALLY_BRIDGE_KEY=           # REQUIRED for bridge mode: openssl rand -hex 32 (same value in tally-bridge/.env)
# Master kill switch. While this is not exactly `true`, vouchers can be drafted, validated and
# previewed but NOTHING is sent to Tally. Keep it false until proven against a test company.
TALLY_POST_ENABLED=false

# ── Nightly batch push (23:50 IST) + Teams approval ──
# Users draft vouchers all day; the 23:50 cron validates them, groups them into a batch, and asks for
# approval in the Teams finance channel. Only an ADMIN can approve — that is what queues them.
TALLY_BATCH_CRON_ENABLED=false
TALLY_BATCH_REQUIRE_APPROVAL=true   # false = push at 23:50 with no human in the loop (not recommended)
TALLY_BATCH_TTL_HOURS=24            # unapproved after this → vouchers return to draft for the next run
TALLY_BATCH_MAX=250                 # max vouchers per batch; the nightly run only ever takes source='manual'
                                    # (bank-statement imports are posted from the import screen instead)
TALLY_NOTIFY_EMPTY=false            # post a card on nights with nothing to send
# Teams finance channel. ONLY ADMINS should be members: Teams gives the listener no role information,
# so membership of this channel IS the approval boundary.
TEAMS_WEBHOOK_FINANCE=              # Workflows "incoming webhook" URL (outbound cards)
TEAMS_CHANNEL_FINANCE=              # channel id the listener watches for yes/no

# ── Shopify ──
SHOPIFY_TOKEN=
SHOPIFY_SHOP_URL=<shop>.myshopify.com
# Auto-hold repeat COD orders on Shopify (fulfillment hold) before EasyEcom imports them.
SHOPIFY_AUTOHOLD_ENABLED=false
# Shopify webhook HMAC secret (Settings → Notifications → Webhooks signing secret, or the app secret)
# for the orders/create webhook → /api/webhook/shopify-order. Leave blank to disable the webhook (503).
SHOPIFY_WEBHOOK_SECRET=

# ── RapidShyp ──
RAPIDSHYP_API_URL=https://api.rapidshyp.com/rapidshyp/apis/v1/
RAPIDSHYP_API_KEY=

# ── DocPharma ──
DOCPHARMA_API_KEY=
DP_PORTAL_EMAIL=
DP_PORTAL_PASSWORD=

# ── Kwikship (GoKwik) — pull-only shipping aggregator; nightly 2 AM tracking sync ──
KWIKSHIP_APP_ID=
KWIKSHIP_APP_SECRET=
KWIKSHIP_BASE_URL=https://api.gokwik.co/kwikship
DP_PORTAL_TOKEN=
# DP_TRIGGER_WORD=rejected        # LIVE uses "rejected"; set "test" on local instances

# ── EasyEcom OMS ──
EASYECOM_BASE_URL=https://api.easyecom.io
EASYECOM_API_KEY=
EASYECOM_WH_KEY=
EASYECOM_JWT=
EASYECOM_EMAIL=
EASYECOM_PASSWORD=
EASYECOM_WEBHOOK_TOKEN=
# Shared secret for the EasyEcom Session Sync Chrome extension (POST /api/webhook/ee-session).
# Generate: openssl rand -hex 24 — put the SAME value in the extension's token box. Endpoint is off until set.
EE_SESSION_PUSH_TOKEN=

# ── Amazon SP-API ──
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-west-1
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
REFRESH_TOKEN=
MARKETPLACE_ID=A21TJRUUN4KGV
BASE_URL=https://sellingpartnerapi-eu.amazon.com

# ── Meta (Facebook) Ads ──
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=

# ── Email (SMTP defaults — the portal Settings can override these) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=                   # Gmail: 16-char App Password
RECIPIENT_EMAIL=
# EMAIL_ENC_KEY=                  # optional 64-hex-char AES key for the portal-stored SMTP password;
                                  # falls back to a key derived from JWT_SECRET — set BEFORE first use,
                                  # never change afterwards or stored passwords won't decrypt

# ── AI (critical-email polish; optional — falls back to a plain template) ──
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com     # Gemini native, or an OpenAI-compatible URL
AI_MODEL=gemini-flash-latest

# ── Microsoft Teams — outbound report webhooks (Power Automate Workflows) ──
TEAMS_WEBHOOK_WAREHOUSE=
TEAMS_WEBHOOK_DP=
TEAMS_WEBHOOK_HOLD=
TEAMS_WEBHOOK_AMAZON=

# ── Cron reporting → Teams "Cron Response" channel ──
# Create a Workflows "incoming webhook" ON THAT CHANNEL (Teams → channel → ⋯ → Workflows →
# "Post to a channel when a webhook request is received") and paste the generated URL here.
# Unset = reporting is silently OFF; the crons themselves are unaffected either way.
TEAMS_WEBHOOK_CRON=
# digest   (default) failures post instantly; successes roll into one periodic digest card
# all      a card per run — very noisy (~1,800 runs/day), debugging only
# failures failures only, no digest
# off      no cron reporting at all
CRON_REPORT_MODE=digest
# MODE=all only: mute the SUCCESS card for these jobs (comma-separated, case-insensitive substring of
# the job name). Failures ALWAYS post, even for a muted job. Use it for the high-frequency watchdogs —
# the two */2 jobs alone are 1,440 runs/day and most are instant no-ops when their feature flag is off.
# Suggested when you turn MODE=all on:  CRON_REPORT_SKIP=TallyBatch,ShopifyHold,EE Session,EscMail
CRON_REPORT_SKIP=
CRON_DIGEST_SCHEDULE=0 9 * * *      # when the digest posts (IST). e.g. '0 * * * *' = hourly
CRON_DIGEST_WHEN_EMPTY=false        # post the digest even if no job ran in the window

# ── Microsoft Teams — inbound approvals ──
# PREFERRED PATH — Teams OUTGOING WEBHOOK (free; Power Automate's generic HTTP action is Premium).
# Team → ⋯ → Manage team → Apps → Create an outgoing webhook. Callback URL = /api/webhook/teams.
# Teams shows a security token ONCE at creation — paste it here verbatim (it is base64; the code
# decodes it to key the HMAC). Commands are @mentioned: "@Pravidhi rejected", "@Pravidhi yes".
TEAMS_OUTGOING_TOKEN=
#
# ALTERNATIVE — a Power Automate flow POSTing to the same route with a shared-secret header. Needs the
# PREMIUM HTTP action. Set a long random value and use it as the Flow's x-teams-token header. Ignored
# when the request carries an HMAC signature instead.
TEAMS_INBOUND_SECRET=             # e.g. openssl rand -hex 24
#
# LEGACY PATH: polling Microsoft Graph. ⚠️ Microsoft gates the Teams MESSAGE APIs behind a separate
# "protected API" approval — without it EVERY read is 403/UnknownError even with ChannelMessage.Read.All
# granted and the user genuinely in the team (confirmed on this tenant 2026-08-14). Set TEAMS_POLL=0 to
# stop the useless reads and hourly token refreshes; the webhook above keeps working.
TEAMS_POLL=                       # 0 = don't poll Graph (leave blank/1 to poll)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_REFRESH_TOKEN=              # auto-rotates; run the listener in ONE process only. Settings → "Teams bot app"
                                  # re-mints it via device code with Team.ReadBasic.All +
                                  # TeamsAppInstallation.ReadWriteForTeam + AppCatalog.ReadWrite.All (add those to the
                                  # app registration with admin consent first) so "Update Teams app" can publish + upgrade
TEAMS_TEAM_ID=
TEAMS_CHANNEL_DP=
TEAMS_CHANNEL_AMAZON=
# TEAMS_LISTENER_DRYRUN=1         # log-only mode (both paths) — actions logged, nothing fired

# ── Slack (LEGACY — decommissioned; posting stays off unless explicitly enabled) ──
# SLACK_ENABLED=true
# SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ── Misc ──
PICKUP_PINCODE=122101             # warehouse origin pincode (serviceability/EDD)
AUTO_REVIEW_CRON=0 10 * * *       # Amazon auto-review schedule (IST)
# CACHE_DIR=.
# GOOGLE_CREDENTIALS={...}        # Google service-account JSON (single line)
